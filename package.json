{
  "name": "tg-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "bun scripts/dev.ts",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "setup": "bun scripts/setup.ts",
    "test": "node_modules/node/bin/node --import tsx --test --test-isolation=none tests/*.test.ts",
    "doctor": "bun scripts/doctor.ts",
    "build:browser": "cd integrations/agent-browser && ../../node_modules/node/bin/node ../../node_modules/eve/bin/eve.js extension build",
    "format": "bun run format:spacing && prettier --write --ignore-unknown --no-error-on-unmatched-pattern agent scripts tests evals package.json tsconfig.json .prettierrc.json",
    "format:check": "bun run format:spacing:check && prettier --check --ignore-unknown --no-error-on-unmatched-pattern agent scripts tests evals package.json tsconfig.json .prettierrc.json",
    "postinstall": "bun run build:browser",
    "test:python": ".venv/bin/python -m unittest userbot.test_app",
    "test:telegram": "node_modules/node/bin/node --import tsx scripts/telegram-acceptance.ts",
    "format:python": "uv tool run --from ruff==0.15.9 ruff format userbot",
    "format:python:check": "uv tool run --from ruff==0.15.9 ruff format --check userbot",
    "format:spacing": "node_modules/node/bin/node --import tsx scripts/spacing.ts --write",
    "format:spacing:check": "node_modules/node/bin/node --import tsx scripts/spacing.ts"
  },
  "dependencies": {
    "@agent-browser/eve": "^0.38.2",
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.105",
    "eve": "0.70.0",
    "luxon": "^3.7.2",
    "zod": "4.5.4",
    "@tg-agent/browser": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "24.x",
    "node": "24",
    "prettier": "3.8.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "workspaces": [
    "integrations/agent-browser"
  ],
  "patchedDependencies": {
    "eve@0.70.0": "patches/eve@0.70.0.patch"
  }
}
